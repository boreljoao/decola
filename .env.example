# ── App / hosts ──────────────────────────────────────────────────────────────
# URL pública do app. Em dev: http://localhost:3000
APP_URL=http://localhost:3000
# Domínio raiz das páginas publicadas ({slug}.<dominio>). Em dev, *.localhost
# resolve nativamente no navegador.
PUBLISH_ROOT_DOMAIN=localhost:3000
# Obrigatório em produção. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Modo explícito (opcional): demo | development | test | production
# DECOLA_MODE=development

# ── Banco de dados ───────────────────────────────────────────────────────────
# Postgres/Supabase (obrigatório em produção). Sem valor em dev, usa PGlite
# local em .data/pglite. Onde obter: Supabase > Project Settings > Database.
DATABASE_URL=

# ── Supabase Auth/Storage (produção) ─────────────────────────────────────────
# Onde obter: Supabase > Project Settings > API. A anon key é pública; a
# service role é SEGREDO de backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Pagamentos (Fase D) ──────────────────────────────────────────────────────
# Stripe (cartão/assinatura): dashboard.stripe.com > Developers > API keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago (Pix): mercadopago.com.br > Suas integrações > Credenciais.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── IA (geração por LLM) ─────────────────────────────────────────────────────
# Sem chave, o motor determinístico identificado é usado. console.anthropic.com
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5

# ── Transcrição de áudio do briefing ─────────────────────────────────────────
# Sem esta chave o áudio continua sendo gravado, guardado e reproduzível — só
# a transcrição automática fica indisponível, e a interface diz isso.
# Onde obter: platform.openai.com > API keys.
OPENAI_API_KEY=

# ── E-mail transacional ──────────────────────────────────────────────────────
# resend.com > API Keys. EMAIL_FROM precisa de domínio remetente verificado.
RESEND_API_KEY=
EMAIL_FROM=

# ── Observabilidade ──────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Worker/fila ──────────────────────────────────────────────────────────────
# Token do endpoint /api/jobs/drain (obrigatório em produção, usado pelo cron).
JOB_DRAIN_TOKEN=
# Só na Vercel: o cron injeta `Authorization: Bearer $CRON_SECRET`. Use o mesmo
# valor de JOB_DRAIN_TOKEN (docs/deploy.md).
CRON_SECRET=
